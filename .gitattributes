# Shell scripts and Python must stay LF: a CRLF shebang line fails on Linux with
# "bash\r: No such file or directory" from both the runner and proot inside the rootfs.
*.sh        text eol=lf
*.py        text eol=lf
gradlew     text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.kts       text eol=lf
*.kt        text eol=lf
*.xml       text eol=lf

# Reference material captured on Windows; rewrite would produce a noisy first commit.
research/*  -text
_recon/*    -text
_p0/downloads/* -text
